<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "StreamVault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="StreamVault">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#09101f">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <% if !user_signed_in? %>
      <link rel="preload" href="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1920&q=80" as="image">
    <% end %>

    <%# Tailwind compiled CSS + custom styles %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-controller="page-loader">
    <%# Page loading overlay — shown during search and content navigation %>
    <div data-page-loader-target="overlay"
         class="hidden fixed inset-0 z-[60] bg-black/80 flex items-center justify-center"
         role="status" aria-live="polite" aria-hidden="true">
      <div class="flex flex-col items-center gap-3 px-5 py-4 rounded-lg bg-sv-surface border border-sv-border shadow-xl">
        <div class="w-10 h-10 border-4 border-white/20 border-t-sv-highlight rounded-full animate-spin"></div>
        <div class="text-sm font-medium text-white" data-page-loader-target="message">Loading...</div>
      </div>
    </div>
    <% if user_signed_in? %>
      <div class="app-shell flex h-full">
        <%# Sidebar %>
        <aside class="sidebar hidden md:flex flex-col w-56 lg:w-60 shrink-0 p-4 lg:p-5">
          <%# Logo %>
          <%= link_to root_path, class: "flex items-center gap-3 px-2 mb-8", aria: { label: "StreamVault home" } do %>
            <span class="brand-mark">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="brand-kicker block">Your screening room</span>
              <span class="brand-name block text-white">StreamVault</span>
            </span>
          <% end %>

          <%# Navigation %>
          <nav class="flex flex-col gap-1 flex-1">
            <%= link_to root_path, class: "sidebar-link #{'active' if controller_name == 'home'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <span>Home</span>
            <% end %>

            <%= link_to browse_path, class: "sidebar-link #{'active' if controller_name.in?(['browse', 'search'])}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <span>Discover</span>
            <% end %>

            <%= link_to library_index_path, class: "sidebar-link #{'active' if controller_name == 'library'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              <span>Library</span>
            <% end %>

            <%= link_to wishlist_index_path, class: "sidebar-link #{'active' if controller_name == 'wishlist'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <span>Wishlist</span>
            <% end %>

            <%= link_to watch_history_index_path, class: "sidebar-link #{'active' if controller_name == 'watch_history'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>History</span>
            <% end %>

            <div class="my-3 border-t border-sv-border/70"></div>

            <%= link_to settings_path, class: "sidebar-link #{'active' if controller_name == 'settings'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Settings</span>
            <% end %>

            <%= link_to cache_status_path, class: "sidebar-link #{'active' if controller_name == 'cache_status'}" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <span>Cache Status</span>
            <% end %>
          </nav>

          <%# Session action %>
          <div class="mt-auto rounded-xl border border-sv-border/70 bg-black/10 p-3">
            <p class="mb-2 truncate text-xs text-sv-text-muted"><%= current_user.email %></p>
            <%= button_to destroy_user_session_path, method: :delete, class: "flex w-full cursor-pointer items-center gap-2 border-0 bg-transparent p-0 text-sm font-semibold text-sv-text-muted transition-colors hover:text-sv-highlight" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              Lock StreamVault
            <% end %>
          </div>
        </aside>

        <%# Main content %>
        <main class="app-main flex-1 overflow-y-auto min-h-screen">
          <%# Persistent top bar: identity on mobile, fast search on larger screens. %>
          <header class="app-topbar">
            <%= link_to root_path, class: "flex md:hidden items-center gap-2 mr-auto", aria: { label: "StreamVault home" } do %>
              <span class="brand-mark !h-9 !w-9 !rounded-xl">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="brand-name text-white">StreamVault</span>
            <% end %>

            <%= form_tag browse_path, method: :get, class: "global-search hidden md:block", data: { turbo_frame: "_top", page_loader: "search" }, role: "search" do %>
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <%= hidden_field_tag :type, "all" %>
              <%= text_field_tag :q, (controller_name == "browse" ? params[:q] : nil), class: "input-field", placeholder: "Search movies and series", aria: { label: "Search movies and series" } %>
            <% end %>

            <div class="ml-auto flex items-center gap-2">
              <%= link_to cache_status_path, class: "grid h-10 w-10 place-items-center rounded-xl text-sv-text-muted transition-colors hover:bg-sv-surface hover:text-sv-highlight #{'bg-sv-surface text-sv-highlight' if controller_name == 'cache_status'}", aria: { label: "Cache status" } do %>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <% end %>
              <%= link_to settings_path, class: "grid h-10 w-10 place-items-center rounded-xl text-sv-text-muted transition-colors hover:bg-sv-surface hover:text-white #{'bg-sv-surface text-white' if controller_name == 'settings'}", aria: { label: "Settings" } do %>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <% end %>
            </div>
          </header>

          <%# Flash messages %>
          <% if notice.present? %>
            <div class="flash-notice mx-6 mt-4" data-controller="flash" data-flash-target="message">
              <%= notice %>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="flash-alert mx-6 mt-4" data-controller="flash" data-flash-target="message">
              <%= alert %>
            </div>
          <% end %>

          <%# Turbo Frame for main content %>
          <turbo-frame id="content" data-turbo-cache="false">
            <%= yield %>
          </turbo-frame>
        </main>

        <%# Mobile bottom nav %>
        <nav class="mobile-nav md:hidden fixed bottom-0 left-0 right-0 border-t border-sv-border/80 flex justify-around pt-2 px-2 z-40" aria-label="Primary navigation">
          <%= link_to root_path, class: "mobile-nav-link #{'active' if controller_name == 'home'}" do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span class="text-xs">Home</span>
          <% end %>
          <%= link_to browse_path, class: "mobile-nav-link #{'active' if controller_name.in?(['browse', 'search'])}" do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span class="text-xs">Discover</span>
          <% end %>
          <%= link_to library_index_path, class: "mobile-nav-link #{'active' if controller_name == 'library'}" do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            <span class="text-xs">Library</span>
          <% end %>
          <%= link_to wishlist_index_path, class: "mobile-nav-link #{'active' if controller_name == 'wishlist'}" do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            <span class="text-xs">Wishlist</span>
          <% end %>
          <%= link_to watch_history_index_path, class: "mobile-nav-link #{'active' if controller_name == 'watch_history'}" do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-xs">History</span>
          <% end %>
        </nav>
      </div>
    <% else %>
      <%# Unauthenticated layout with cinema background %>
      <div class="min-h-screen flex flex-col relative">
        <div class="absolute inset-0 bg-sv-bg">
          <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1920&q=80'); filter: brightness(0.3);"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-sv-bg via-sv-bg/80 to-transparent"></div>
        </div>
        <div class="relative z-10 flex flex-col min-h-screen">
          <% if notice.present? %>
            <div class="flash-notice mx-6 mt-4"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="flash-alert mx-6 mt-4"><%= alert %></div>
          <% end %>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
