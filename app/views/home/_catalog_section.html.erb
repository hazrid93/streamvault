<%# Reusable catalog carousel section.
    locals:
      title:         section heading
      items:         array of item hashes (imdb_id, title, poster_url, year, type)
      type:          default content type for links ("movie"/"show")
      browse_path:   optional "Browse all" link
      view_all_path:  optional "View all" link
%>
<% if items.any? %>
  <section class="mb-12" data-controller="carousel" aria-labelledby="section-<%= title.parameterize %>">
    <div class="flex items-center justify-between gap-4 mb-4">
      <h2 id="section-<%= title.parameterize %>" class="section-heading text-white"><%= title %></h2>
      <div class="flex items-center gap-2">
        <% if local_assigns[:view_all_path] %>
          <%= link_to "View all", view_all_path, class: "section-link" %>
        <% end %>
        <% if local_assigns[:browse_path] %>
          <%= link_to "Browse all", browse_path, class: "section-link" %>
        <% end %>
        <button data-action="click->carousel#prev" data-carousel-target="prevBtn"
                class="invisible grid h-9 w-9 place-items-center rounded-xl border border-sv-border bg-sv-surface text-white transition-colors hover:border-sv-accent hover:bg-sv-surface-hover" aria-label="Scroll <%= title %> backward">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button data-action="click->carousel#next" data-carousel-target="nextBtn"
                class="grid h-9 w-9 place-items-center rounded-xl border border-sv-border bg-sv-surface text-white transition-colors hover:border-sv-accent hover:bg-sv-surface-hover" aria-label="Scroll <%= title %> forward">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
    <div class="relative">
      <div data-carousel-target="track"
           class="flex gap-4 overflow-x-auto scrollbar-hide pb-4 pt-1" tabindex="0" aria-label="<%= title %>">
        <% items.each do |item| %>
          <%= render "shared/poster_card",
                item: item,
                link_path: content_path(type: item[:type].presence || type, imdb_id: item[:imdb_id]) %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>