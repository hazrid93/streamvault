<div class="page-shell !max-w-3xl">
  <header class="mb-8"><p class="eyebrow mb-2">Make it yours</p><h1 class="page-heading text-white">Settings</h1><p class="page-subtitle">Manage access, streaming, and language preferences.</p></header>
  <% pin_error_attributes = %i[current_pin pin pin_confirmation] %>
  <% pin_errors, settings_errors = @user.errors.partition { |error| pin_error_attributes.include?(error.attribute) } %>

  <%= form_with url: settings_pin_path, method: :patch, class: "mb-6 rounded-2xl border border-sv-border bg-sv-surface/75 p-5 shadow-xl shadow-black/10 sm:p-6" do %>
    <p class="eyebrow mb-2">Security</p><h2 class="section-heading text-sv-text">Change PIN</h2>
    <p id="settings-pin-guidance" class="mt-1 text-xs text-sv-text-muted">Enter your current PIN, then choose a new PIN using exactly 4 digits (0–9).</p>

    <% if pin_errors.any? %>
      <div id="settings-pin-errors" class="flash-alert mt-4" role="alert" aria-live="assertive">
        <p class="text-sm font-medium">Your PIN could not be changed:</p>
        <ul class="mt-1 list-disc space-y-1 pl-5 text-sm">
          <% pin_errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-5 space-y-4">
      <div>
        <%= label_tag :current_pin, "Current PIN", class: "mb-1.5 block text-sm font-medium text-sv-text-muted" %>
        <%= password_field_tag :current_pin, nil,
              class: "input-field max-w-xs text-center text-xl tracking-widest tabular-nums",
              inputmode: "numeric",
              pattern: "[0-9]{4}",
              minlength: 4,
              maxlength: 4,
              autocomplete: "current-password",
              required: true,
              aria: {
                describedby: "settings-pin-guidance#{' settings-pin-errors' if pin_errors.any?}",
                invalid: pin_errors.any? { |error| error.attribute == :current_pin }
              } %>
      </div>

      <div>
        <%= label_tag :pin, "New PIN", class: "mb-1.5 block text-sm font-medium text-sv-text-muted" %>
        <%= password_field_tag :pin, nil,
              class: "input-field max-w-xs text-center text-xl tracking-widest tabular-nums",
              inputmode: "numeric",
              pattern: "[0-9]{4}",
              minlength: 4,
              maxlength: 4,
              autocomplete: "new-password",
              required: true,
              aria: {
                describedby: "settings-pin-guidance#{' settings-pin-errors' if pin_errors.any?}",
                invalid: pin_errors.any? { |error| error.attribute == :pin }
              } %>
      </div>

      <div>
        <%= label_tag :pin_confirmation, "Confirm new PIN", class: "mb-1.5 block text-sm font-medium text-sv-text-muted" %>
        <%= password_field_tag :pin_confirmation, nil,
              class: "input-field max-w-xs text-center text-xl tracking-widest tabular-nums",
              inputmode: "numeric",
              pattern: "[0-9]{4}",
              minlength: 4,
              maxlength: 4,
              autocomplete: "new-password",
              required: true,
              aria: {
                describedby: "settings-pin-guidance#{' settings-pin-errors' if pin_errors.any?}",
                invalid: pin_errors.any? { |error| error.attribute == :pin_confirmation }
              } %>
      </div>
    </div>

    <%= submit_tag "Change PIN", class: "btn-primary mt-5 cursor-pointer" %>
  <% end %>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-6" do |f| %>
    <% if settings_errors.any? %>
      <div class="flash-alert" role="alert" aria-live="assertive">
        <ul class="list-inside list-disc text-sm">
          <% settings_errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


    <div class="rounded-2xl border border-sv-border bg-sv-surface/75 p-5 shadow-xl shadow-black/10 sm:p-6">
      <p class="eyebrow mb-2">Streaming</p><h2 class="section-heading text-white mb-4">RealDebrid</h2>

      <div class="mb-4">
        <%= f.label :realdebrid_api_key, "API Key", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.password_field :realdebrid_api_key, class: "input-field", placeholder: "Enter your RealDebrid API key", value: "" %>
        <p class="text-xs text-sv-text-muted mt-1">Get your API key from <a href="https://real-debrid.com/apitoken" target="_blank" class="text-sv-accent">real-debrid.com/apitoken</a></p>
      </div>

      <% if @user.has_realdebrid_key? %>
        <div class="flex items-center gap-2 text-sv-success text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          API key configured
        </div>
      <% end %>

      <div class="mt-5 border-t border-sv-border/70 pt-5">
        <%= f.label :streaming_preference, "Preferred source", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.select :streaming_preference,
              options_for_select(User::STREAMING_PREFERENCES.map { |value, label| [label, value] }, @user.streaming_preference),
              {}, class: "input-field" %>
        <p class="mt-2 text-xs leading-5 text-sv-text-muted">Automatic uses RealDebrid when available and falls back to the private local torrent engine. You can still choose either source on an individual stream.</p>
      </div>
    </div>

    <div class="rounded-2xl border border-sv-border bg-sv-surface/75 p-5 shadow-xl shadow-black/10 sm:p-6">
      <p class="eyebrow mb-2">Playback</p><h2 class="section-heading text-white mb-2">Preferred languages</h2>
      <p class="text-xs text-sv-text-muted mb-4">Select at least one language. Streams without at least one of your selected languages will be filtered out.</p>

      <div class="flex flex-wrap gap-2 mb-4" data-controller="language-picker">
        <% User::STREAM_LANGUAGE_OPTIONS.each do |code, name| %>
          <% selected = Array(@user.preferred_languages).include?(code) %>
          <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm cursor-pointer transition-colors"
                 data-language-picker-target="pill"
                 data-code="<%= code %>"
                 data-selected="<%= selected %>"
                 style="<%= selected ? 'background-color: var(--color-sv-accent); color: white;' : 'background-color: var(--color-sv-surface-hover); color: var(--color-sv-text-muted);' %>">
            <input type="checkbox" name="user[preferred_languages][]" value="<%= code %>" <%= 'checked' if selected %> class="hidden">
            <span><%= name %></span>
          </label>
        <% end %>
      </div>
      <input type="hidden" name="user[preferred_languages][]" value="">
    </div>

    <div class="rounded-2xl border border-sv-border bg-sv-surface/75 p-5 shadow-xl shadow-black/10 sm:p-6">
      <h2 class="section-heading text-white mb-2">Default language</h2>
      <p class="text-xs text-sv-text-muted mb-4">Default audio language when starting a stream.</p>

      <%= f.select :default_language,
        options_for_select(
          Array(@user.preferred_languages).map { |c| [User::STREAM_LANGUAGE_OPTIONS[c], c] },
          @user.default_language
        ),
        {},
        class: "input-field w-auto"
      %>
    </div>

    <%= f.submit "Save settings", class: "btn-primary cursor-pointer" %>
  <% end %>

  <section class="mt-6 rounded-2xl border border-sv-border bg-sv-surface/75 p-5 shadow-xl shadow-black/10 sm:p-6" aria-labelledby="local-storage-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="eyebrow mb-2">Temporary storage</p>
        <h2 id="local-storage-heading" class="section-heading text-white">Local torrent cache</h2>
        <p class="mt-2 max-w-xl text-xs leading-5 text-sv-text-muted">A rolling cache stores only the pieces needed around playback. It is removed automatically after playback disconnects and never becomes part of your permanent library.</p>
      </div>
      <% if @local_torrent_status[:reachable] %>
        <span class="badge badge-success shrink-0">Engine online</span>
      <% else %>
        <span class="badge badge-warning shrink-0"><%= @local_torrent_status[:enabled] ? "Engine unavailable" : "Disabled" %></span>
      <% end %>
    </div>

    <% used = @local_torrent_status[:used_bytes].to_i %>
    <% quota = @local_torrent_status[:quota_bytes].to_i %>
    <% percent = quota.positive? ? [(used.to_f / quota * 100).round(1), 100].min : 0 %>
    <div class="mt-6">
      <div class="mb-2 flex items-end justify-between gap-4">
        <div><span class="text-2xl font-bold tracking-tight text-white"><%= number_to_human_size(used) %></span><span class="text-sm text-sv-text-muted"> of <%= number_to_human_size(quota) %></span></div>
        <span class="font-mono text-xs text-sv-text-muted"><%= percent %>%</span>
      </div>
      <div class="h-2 overflow-hidden rounded-full bg-sv-bg" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="Local torrent cache usage">
        <div class="h-full rounded-full bg-gradient-to-r from-sv-accent to-sv-highlight" style="width: <%= percent %>%"></div>
      </div>
      <div class="mt-3 grid gap-2 text-xs text-sv-text-muted sm:grid-cols-3">
        <span>Free on server: <strong class="text-white"><%= @local_torrent_status[:free_bytes] ? number_to_human_size(@local_torrent_status[:free_bytes]) : "Unknown" %></strong></span>
        <span>Safety reserve: <strong class="text-white"><%= number_to_human_size(@local_torrent_status[:minimum_free_bytes]) %></strong></span>
        <span>Active streams: <strong class="text-white"><%= @local_torrent_status[:active_count] %></strong></span>
      </div>
    </div>

    <% if @local_torrent_status[:torrents].any? %>
      <div class="mt-5 space-y-2 border-t border-sv-border/70 pt-4">
        <% @local_torrent_status[:torrents].each do |torrent| %>
          <div class="flex items-center justify-between gap-3 rounded-xl bg-sv-bg/50 px-3 py-2">
            <div class="min-w-0"><p class="truncate text-sm font-medium text-white"><%= torrent[:title] %></p><p class="mt-0.5 text-xs text-sv-text-muted"><%= torrent[:state] %> · <%= number_to_human_size(torrent[:used_bytes]) %> cached · <%= number_to_human_size(torrent[:download_speed]) %>/s</p></div>
            <span class="text-xs text-sv-text-muted"><%= torrent[:seeders] %> seeders</span>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-sv-border/70 pt-5">
      <%= button_to "Clear temporary media", settings_local_torrents_path, method: :delete,
            class: "btn-secondary cursor-pointer disabled:cursor-not-allowed disabled:opacity-50",
            disabled: @local_torrent_status[:active_count].positive? || !@local_torrent_status[:reachable],
            data: { turbo_confirm: "Delete all inactive local torrent data? This cannot be undone." } %>
      <p class="text-xs text-sv-text-muted"><%= @local_torrent_status[:active_count].positive? ? "Stop playback and wait about one minute before clearing." : "Only temporary torrent pieces and metadata are removed." %></p>
    </div>
  </section>
</div>
