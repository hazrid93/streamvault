<div class="player-container" data-controller="video-player"
     data-video-player-streaming-url-value="<%= @streaming_url %>"
     data-video-player-direct-url-value="<%= @direct_url %>"
     data-video-player-direct-stream-url-value="<%= @direct_stream_url %>"
     data-video-player-filename-value="<%= @filename %>"
     data-video-player-imdb-id-value="<%= @imdb_id %>"
     data-video-player-type-value="<%= @type %>"
     data-video-player-season-value="<%= @season %>"
     data-video-player-episode-value="<%= @episode %>"
     data-video-player-resume-at-value="<%= @resume_at %>"
     data-video-player-start-seconds-value="<%= @resume_at.present? ? @resume_at : 0 %>"
     data-video-player-duration-value="<%= @duration || 0 %>"
     data-video-player-title-value="<%= @title %>"
     data-video-player-poster-url-value="<%= @poster_url %>"
     data-video-player-default-language-value="<%= @default_language %>"
     data-video-player-preferred-languages-value="<%= @preferred_languages.to_json %>"
     data-video-player-tracks-url-value="<%= transcode_tracks_path %>"
     data-video-player-subtitles-url-value="<%= transcode_subtitles_path %>"
     data-video-player-thumbnail-url-value="<%= transcode_thumbnail_path %>"
     data-video-player-progress-url-value="<%= progress_streaming_path("play") %>"
     data-video-player-resume-url-value="<%= resume_streaming_index_path %>"
     data-video-player-next-episode-title-value="<%= @next_episode&.dig(:title) || "" %>"
     data-video-player-has-next-episode-value="<%= @next_episode.present? ? "true" : "false" %>"
     data-video-player-local-torrent-hash-value="<%= @local_torrent_hash %>"
     data-video-player-local-torrent-session-value="<%= @local_torrent_session %>"
     data-video-player-local-status-url-value="<%= @local_torrent_hash.present? ? local_torrent_status_path : "" %>"
     data-video-player-local-stop-url-value="<%= @local_torrent_hash.present? ? stop_local_torrent_path : "" %>"
     data-video-player-cast-sessions-url-value="<%= cast_sessions_path %>">

  <%# Back button %>
  <div class="absolute top-4 left-4 z-50 opacity-100 transition-opacity duration-500" data-video-player-target="backButton"
       style="top: calc(env(safe-area-inset-top, 0px) + 1rem); left: calc(env(safe-area-inset-left, 0px) + 1rem);">
    <%= link_to content_path(type: @type, imdb_id: @imdb_id, season: @season),
          class: "flex items-center gap-2 px-3 py-2 bg-black/60 rounded-lg text-white hover:bg-black/80 transition-colors",
          data: { action: "click->video-player#navigateBack" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span class="text-sm"><%= @title %></span>
    <% end %>
  </div>

  <%# Source info (top right, auto-hides) %>
  <div data-video-player-target="sourceInfo" class="hidden absolute top-4 right-4 z-10 max-w-lg opacity-100 transition-opacity duration-500"
       style="top: calc(env(safe-area-inset-top, 0px) + 1rem); right: calc(env(safe-area-inset-right, 0px) + 1rem);">
    <button data-action="click->video-player#toggleSourceInfo" data-video-player-target="sourceToggle" class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
      Stream info
    </button>
    <div data-video-player-target="sourceDetails" class="hidden mt-2 p-3 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 break-all">
      <p><span class="text-sv-text">Source:</span> <span data-video-player-target="sourceUrl"></span></p>
      <p><span class="text-sv-text">File:</span> <span data-video-player-target="sourceFilename"></span></p>
      <% if @local_torrent_hash.present? %>
        <p class="border-t border-white/10 pt-2 text-sv-success"><span class="text-sv-text">Local:</span> <span data-video-player-target="localStats">Connecting to peers…</span></p>
      <% end %>
    </div>
  </div>

  <%# Video element — no native controls, custom UI below %>
  <video data-video-player-target="video" id="stream-player"
         autoplay playsinline x-webkit-airplay="allow"
         class="w-full h-full"
         style="object-fit: contain; background: #000;">
  </video>

  <%# Primary touch controls. On narrow screens these sit below the title
      and stream-info row; wider screens have enough room to keep them at
      the very top. The compact group only intercepts taps on its buttons. %>
  <div data-video-player-target="topControls"
       class="absolute top-16 md:top-4 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 rounded-full border border-white/15 bg-black/70 p-1.5 text-white shadow-xl backdrop-blur-sm opacity-100 transition-opacity duration-500"
       style="margin-top: env(safe-area-inset-top, 0px);"
       role="group"
       aria-label="Playback controls">
    <button type="button"
            data-action="click->video-player#skipBack"
            class="relative flex min-h-12 min-w-12 items-center justify-center rounded-full text-white/90 transition-colors hover:bg-white/15 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
            aria-label="Back 10 seconds"
            title="Back 10 seconds">
      <span class="relative block h-7 w-7" aria-hidden="true">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 28 28" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 7H5V3M5.6 7A10 10 0 1 1 4.8 18"/>
        </svg>
        <span class="absolute inset-0 flex items-center justify-center pt-0.5 text-[9px] font-bold tabular-nums">10</span>
      </span>
    </button>

    <button type="button"
            data-action="click->video-player#togglePlay"
            class="flex min-h-14 min-w-14 items-center justify-center rounded-full bg-white text-black shadow-lg transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400 active:scale-95"
            aria-label="Play or pause">
      <svg data-video-player-target="playIcon" class="h-7 w-7 hidden" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      <svg data-video-player-target="pauseIcon" class="h-7 w-7" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>

    <button type="button"
            data-action="click->video-player#skipForward"
            class="relative flex min-h-12 min-w-12 items-center justify-center rounded-full text-white/90 transition-colors hover:bg-white/15 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
            aria-label="Forward 10 seconds"
            title="Forward 10 seconds">
      <span class="relative block h-7 w-7" aria-hidden="true">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 28 28" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7h4V3M22.4 7A10 10 0 1 0 23.2 18"/>
        </svg>
        <span class="absolute inset-0 flex items-center justify-center pt-0.5 text-[9px] font-bold tabular-nums">10</span>
      </span>
    </button>
  </div>

  <div data-video-player-target="subtitleOverlay"
       class="hidden pointer-events-none absolute inset-x-0 z-20 px-6 text-center"
       style="bottom: 6.5rem; transition: bottom 0.3s ease; padding-left: calc(env(safe-area-inset-left, 0px) + 1.5rem); padding-right: calc(env(safe-area-inset-right, 0px) + 1.5rem);">
    <span data-video-player-target="subtitleText"
          class="inline-block max-w-3xl px-4 py-2 rounded-lg bg-black/60 text-center text-lg font-semibold text-white"
          style="white-space: pre-line; text-shadow: 0 2px 8px rgba(0,0,0,0.95);"></span>
  </div>

  <%# Initial playback overlay (hidden once media actually starts playing) %>
  <div data-video-player-target="startupOverlay"
       class="absolute inset-0 z-30 flex items-center justify-center bg-black/80 transition-opacity duration-200"
       role="status"
       aria-live="polite"
       aria-hidden="false">
    <div class="flex flex-col items-center gap-3 px-5 py-4 rounded-lg bg-sv-surface border border-sv-border shadow-xl">
      <div class="w-12 h-12 border-4 border-white/20 border-t-indigo-500 rounded-full animate-spin"></div>
      <span class="text-white text-sm font-medium">Starting playback</span>
      <span class="text-sv-text-muted text-xs">Preparing stream...</span>
    </div>
  </div>

  <%# Custom controls bar %>
  <div data-video-player-target="controls"
       class="absolute bottom-0 left-0 right-0 z-10 bg-gradient-to-t from-black/90 via-black/50 to-transparent pt-16 pb-3 px-4 opacity-100 transition-opacity duration-500"
       style="padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem); padding-left: calc(env(safe-area-inset-left, 0px) + 1rem); padding-right: calc(env(safe-area-inset-right, 0px) + 1rem);">

    <%# Seek bar %>
    <div data-video-player-target="seekBar"
         data-action="click->video-player#seek mousedown->video-player#startSeekDrag mouseup->video-player#stopSeekDrag touchstart->video-player#startSeekDrag touchend->video-player#stopSeekDrag touchcancel->video-player#cancelSeekDrag"
         class="group relative h-1.5 bg-white/20 rounded-full cursor-pointer mb-3 hover:h-2.5 transition-all">
      <%# A real frame from the selected source timeline. The controller keeps
          this box clamped to the seek bar while its pointer follows the finger. %>
      <div data-video-player-target="seekPreview"
           class="hidden pointer-events-none absolute bottom-full z-30 mb-3 overflow-visible rounded-lg border border-white/20 bg-black shadow-2xl"
           style="left: 50%; width: min(178px, calc(100vw - 2rem)); transform: translateX(-50%);"
           aria-hidden="true">
        <div class="relative h-[100px] overflow-hidden rounded-lg bg-black">
          <div data-video-player-target="seekPreviewLoading"
               class="absolute inset-0 flex items-center justify-center bg-black/90 text-white/70">
            <span class="h-5 w-5 animate-spin rounded-full border-2 border-white/25 border-t-indigo-400" aria-hidden="true"></span>
            <span class="sr-only">Loading frame preview</span>
          </div>
          <img data-video-player-target="seekPreviewImage"
               class="hidden h-full w-full object-contain"
               alt=""
               draggable="false">
          <span data-video-player-target="seekPreviewTime"
                class="absolute bottom-1 right-1 rounded bg-black/75 px-1.5 py-0.5 text-[11px] font-semibold tabular-nums text-white shadow">
            0:00
          </span>
        </div>
        <span data-video-player-target="seekPreviewPointer"
              class="absolute -bottom-1.5 h-0 w-0 -translate-x-1/2"
              style="left: 50%; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 6px solid rgba(255,255,255,0.8);"
              aria-hidden="true"></span>
      </div>

      <div data-video-player-target="seekBuffered" class="absolute inset-y-0 bg-white/30 rounded-full" style="left: 0%; width: 0%"></div>
      <div data-video-player-target="seekFilled" class="absolute inset-y-0 left-0 bg-indigo-500 rounded-full" style="width: 0%"></div>
      <div data-video-player-target="seekHandle" class="absolute w-3 h-3 bg-white rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity" style="left: 0%; top: 50%; transform: translate(-50%, -50%)"></div>
    </div>

    <%# Controls row %>
    <div class="flex min-w-0 items-center gap-2 text-white text-sm sm:gap-3">
      <%# Play/pause %>
      <button type="button" data-action="click->video-player#togglePlay" data-video-player-target="playButton" class="hover:text-indigo-400 transition-colors" aria-label="Play or pause">
        <svg data-video-player-target="playIcon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg data-video-player-target="pauseIcon" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <%# Skip back 10s %>
      <button type="button" data-action="click->video-player#skipBack" class="hover:text-indigo-400 transition-colors" title="Back 10s (←)" aria-label="Back 10 seconds">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M20 19l-7-7 7-7"/></svg>
      </button>
      <%# Skip forward 10s %>
      <button type="button" data-action="click->video-player#skipForward" class="hover:text-indigo-400 transition-colors" title="Forward 10s (→)" aria-label="Forward 10 seconds">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M4 5l7 7-7 7"/></svg>
      </button>

      <%# Time display %>
      <span data-video-player-target="currentTime" class="tabular-nums"><%= player_time(@resume_at) %></span>
      <span class="text-white/40">/</span>
      <span data-video-player-target="durationDisplay" class="text-white/60 tabular-nums"><%= @duration.to_f.positive? ? player_time(@duration) : "--:--" %></span>

      <%# AirPlay / Chromecast / Remote Playback — kept before the flexible
           spacer so it remains visible on narrow phone controls. %>
      <button type="button" data-video-player-target="castButton"
              data-action="click->video-player#castToDevice"
              class="hidden min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg text-white hover:text-sv-highlight transition-colors"
              title="Play on a nearby TV or device" aria-label="Cast to nearby device">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6.5A1.5 1.5 0 015.5 5h13A1.5 1.5 0 0120 6.5v9a1.5 1.5 0 01-1.5 1.5H16M4 17a3 3 0 013 3M4 13a7 7 0 017 7M4 9a11 11 0 0111 11"/></svg>
      </button>

      <div class="flex-1"></div>

      <%# Volume %>
      <button data-action="click->video-player#toggleMute" class="hover:text-indigo-400 transition-colors">
        <svg data-video-player-target="volumeIcon" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        <svg data-video-player-target="muteIcon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
      </button>

      <%# Audio tracks %>
      <div data-video-player-target="audioControls" class="hidden relative">
        <button type="button"
                data-action="click->video-player#toggleAudioMenu"
                class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
          <span data-video-player-target="audioButtonLabel">Audio</span>
        </button>
        <div data-video-player-target="audioMenu"
             class="hidden absolute z-20 p-2 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 border border-white/20"
             style="right: 0; bottom: 2rem; min-width: 14rem; max-height: 14rem; overflow-y: auto;">
          <div data-video-player-target="audioOptions"></div>
        </div>
      </div>

      <%# Subtitle tracks %>
      <div data-video-player-target="subtitleControls" class="hidden relative">
        <button type="button"
                data-action="click->video-player#toggleSubtitleMenu"
                class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
          <span data-video-player-target="subtitleButtonLabel">CC</span>
        </button>
        <div data-video-player-target="subtitleMenu"
             class="hidden absolute z-20 p-2 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 border border-white/20"
             style="right: 0; bottom: 2rem; min-width: 14rem; max-height: 14rem; overflow-y: auto;">
          <div data-video-player-target="subtitleOptions"></div>
          <%# Subtitle sync adjustment — applies to overlay and native iOS cues. %>
          <div class="mt-2 pt-2 border-t border-white/10" data-subtitle-offset-controls>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-white font-medium">Subtitle delay</span>
              <span data-subtitle-offset-label class="text-sv-accent tabular-nums">+0.0s</span>
            </div>
            <div class="grid grid-cols-3 gap-1 mb-2">
              <button type="button"
                      data-subtitle-offset-delta="-1"
                      data-action="click->video-player#adjustSubtitleOffset"
                      class="px-2 py-1.5 rounded bg-white/10 text-white hover:bg-white/20"
                      title="Show subtitles one second earlier">Earlier −1s</button>
              <button type="button"
                      data-action="click->video-player#resetSubtitleOffset"
                      class="px-2 py-1.5 rounded bg-white/10 text-white hover:bg-white/20">Reset</button>
              <button type="button"
                      data-subtitle-offset-delta="1"
                      data-action="click->video-player#adjustSubtitleOffset"
                      class="px-2 py-1.5 rounded bg-white/10 text-white hover:bg-white/20"
                      title="Show subtitles one second later">Later +1s</button>
            </div>
            <input type="range" min="-50" max="50" value="0" step="1"
                   data-subtitle-offset-range
                   data-action="input->video-player#setSubtitleOffset"
                   class="w-full accent-indigo-500"
                   aria-label="Subtitle delay in tenths of a second">
            <div class="flex justify-between text-[10px] mt-0.5 text-sv-text-muted">
              <span>5s earlier</span><span>0</span><span>5s later</span>
            </div>
          </div>
        </div>
      </div>



      <%# Fullscreen — browser fullscreen via the standard Fullscreen API.
           Takes the whole player container (controls + subtitle overlay)
           into fullscreen as a single unit, so subtitles keep working. %>
      <button data-video-player-target="fullscreenButton"
              data-action="click->video-player#toggleFullscreen" class="hover:text-indigo-400 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      </button>

      <%# Playback speed %>
      <div class="relative">
        <button type="button" data-video-player-target="speedButton"
                data-action="click->video-player#toggleSpeedMenu"
                class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors tabular-nums"
                title="Playback speed">1×</button>
        <div data-video-player-target="speedMenu"
             class="hidden absolute z-20 p-2 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 border border-white/20"
             style="right: 0; bottom: 2rem; min-width: 8rem;"></div>
      </div>
    </div>
  </div>

  <%# Loading overlay (shown while ffmpeg restarts after a seek, subtitles catch up, or the stream buffers). bg-black/80 so the spinner is visible — with MSE, when the buffer runs dry Chrome shows black, not a frozen frame, so a transparent overlay would be invisible. %>
  <div data-video-player-target="seekingOverlay" class="hidden absolute inset-0 flex items-center justify-center bg-black/80 z-20">
    <div class="flex flex-col items-center gap-4">
      <div class="w-14 h-14 border-4 border-white/20 border-t-indigo-500 rounded-full animate-spin"></div>
      <span data-video-player-target="seekingOverlayMessage" class="text-white text-sm font-medium" style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);">Seeking...</span>
    </div>
  </div>

  <%# Up Next: end-of-episode countdown card (shown by onVideoEnded) %>
  <% if @next_episode.present? %>
    <div data-video-player-target="nextEpisodeCard" class="hidden absolute inset-0 flex items-center justify-center bg-black/90 z-30">
      <div class="text-center max-w-md px-6">
        <p class="text-xs uppercase tracking-wider text-sv-accent font-semibold mb-2">Up Next</p>
        <p class="text-lg font-bold text-white mb-1"><%= @next_episode[:title] %></p>
        <p class="text-sm text-sv-text-muted mb-6">S<%= @next_episode[:season].to_s.rjust(2, '0') %>E<%= @next_episode[:episode].to_s.rjust(2, '0') %></p>
        <div class="flex items-center justify-center gap-4">
          <button type="button" data-action="click->video-player#advanceToNextEpisode"
                class="px-5 py-2.5 bg-sv-accent hover:bg-sv-accent-hover text-white rounded-lg font-medium text-sm transition-colors">Play now</button>
          <button type="button" data-action="click->video-player#cancelNextEpisode"
                class="px-5 py-2.5 bg-sv-surface hover:bg-sv-surface-hover text-white rounded-lg font-medium text-sm transition-colors">Cancel</button>
        </div>
        <p class="text-xs text-sv-text-muted mt-6">Auto-playing in <span data-next-countdown>10</span>s</p>
      </div>
    </div>
  <% end %>

</div>
