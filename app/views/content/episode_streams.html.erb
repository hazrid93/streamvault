<div data-controller="stream-filter">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div>
      <p class="text-sm font-semibold text-white"><%= @episode_title.presence || "Episode #{@episode}" %></p>
      <p class="mt-0.5 text-xs text-sv-text-muted">Providers load independently—choose any result as soon as it appears.</p>
    </div>
    <div class="flex items-center gap-1.5">
      <% ["all", "4K", "1080p", "720p"].each do |quality| %>
        <button type="button" data-action="click->stream-filter#filter" data-quality="<%= quality %>"
              class="rounded-full border border-sv-border px-2 py-1 text-[0.65rem] font-medium text-sv-text-muted hover:text-white"><%= quality == "all" ? "All" : quality %></button>
      <% end %>
    </div>
  </div>

  <% if @stream_providers.any? %>
    <div class="grid gap-3">
      <% stream_title = "#{@show_title} S#{@season.to_s.rjust(2, '0')}E#{@episode.to_s.rjust(2, '0')}" %>
      <% @stream_providers.each do |provider| %>
        <%= render "content/stream_provider_loader",
              provider: provider, imdb_id: @imdb_id, type: "show",
              season: @season, episode: @episode, title: stream_title,
              poster_url: @poster_url, duration: @episode_duration_seconds %>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-lg bg-sv-surface px-3 py-3 text-sm text-sv-text-muted">No stream provider is configured.</p>
  <% end %>

  <p data-stream-filter-target="empty" class="hidden mt-3 text-sm text-sv-text-muted">No loaded streams match this quality.</p>
</div>